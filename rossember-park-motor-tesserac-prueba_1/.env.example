
# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO - rossember-park
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo .env a GitHub.
# ============================================================

# Google AI Studio API Key
# Obtén tu clave en: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=TU_API_KEY_AQUI

# Wompi (Pasarela de Pagos)
# Obtén en: https://comercios.wompi.co/
VITE_WOMPI_PUBLIC_KEY=pub_test_XXXXXX

# n8n Webhook para Pagos
VITE_N8N_WEBHOOK_URL=https://tu-n8n.com/webhook/pago-confirmado

# Credenciales del Administrador
# CAMBIA ESTOS VALORES antes de subir a producción
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA
