# --- PROXY SEGURO (Cloudflare Worker) ---
# La API Key de Gemini vive en Cloudflare, NO aquí.
# Pon la URL de tu Worker después de desplegarlo:
# Ejemplo: https://rossember-gemini.TU-USUARIO.workers.dev
VITE_GEMINI_WORKER_URL=https://gentle-night-fead.ciberneticaysistemas.workers.dev

# Para desarrollo local (descomentar cuando uses wrangler dev):
# VITE_GEMINI_WORKER_URL=http://localhost:8787

# --- Wompi (Pasarela de Pagos) - Obtén en: https://wompi.com ---
VITE_WOMPI_PUBLIC_KEY=pub_test_XXXXXX

# --- n8n Webhook para Pagos ---
VITE_N8N_WEBHOOK_URL=https://tu-n8n.com/webhook/pago-confirmado

# --- Credenciales del Administrador ---
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=admin123
